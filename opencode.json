{
	"$schema": "https://opencode.ai/config.json",
	"share": "auto",
	"autoupdate": true,
	"plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
	"model": "opencode/muse-spark-1.3-contributor-free",
	"small_model": "opencode/big-pickle",
	"default_agent": "build",
	"instructions": ["AGENTS.md", "CLAUDE.md"],
	"mcp": {
		"playwright": {
			"type": "local",
			"command": ["npx", "--yes", "@playwright/mcp@0.0.81"],
			"timeout": 60000,
			"enabled": true
		}
	},
	"skills": {
		"paths": [".claude/skills"]
	},
	"worktree": {
		"directory": ".claude/worktrees"
	},
	"references": {
		"docs": {
			"path": "../pending",
			"description": "Product behavior and documentation conventions are pending"
		}
	},
	"permission": {
		"edit": "ask",
		"bash": "ask"
	}
}
