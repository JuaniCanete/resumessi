{
  "name": "resumessi",
  "version": "1.2.0",
  "description": "AI-powered resume scoring and generation tool using AI providers and models",
  "main": "public/main.html",
  "scripts": {
    "start": "tsx start.ts",
    "setup": "tsx setup.ts",
    "validate": "tsx scripts/validate.ts",
    "prebuild": "tsx scripts/validate.ts",
    "build": "tsx build.ts",
    "build:check": "tsx build.ts --check",
    "generate": "tsx src/resume/generate-resume.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "html:validate": "html-validate public/**/*.html",
    "css:validate": "stylelint \"public/**/*.html\" --custom-syntax postcss-html",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "evals": "tsx scripts/run-evals.ts",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.html": [
      "html-validate",
      "stylelint --custom-syntax postcss-html"
    ]
  },
  "keywords": [
    "resume",
    "ats",
    "ai",
    "cv",
    "scoring",
    "generation"
  ],
  "author": "Juani Cañete",
  "license": "MIT",
  "dependencies": {
    "busboy": "^1.6.0",
    "pdf-parse": "^1.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.1.1",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.1.4",
    "html-validate": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}