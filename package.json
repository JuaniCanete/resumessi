{
	"name": "resumessi",
	"version": "2.3.1",
	"description": "AI-powered job seeker and validator",
	"main": "public/main.html",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"setup": "tsx setup.ts",
		"preflight": "tsx scripts/preflight.ts",
		"prebuild": "npm run preflight -- --skip-evals",
		"build": "tsx build.ts",
		"prestart": "npm run build",
		"start": "tsx start.ts",
		"generate": "tsx src/resume/generate-resume.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix --max-warnings=0",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"html:validate": "html-validate public/**/*.html",
		"css:validate": "stylelint \"public/**/*.html\" --custom-syntax postcss-html",
		"test:unit": "cross-env NODE_ENV=test tsx --test --test-reporter=spec \"tests/unit/**/*.test.ts\"",
		"test:coverage": "cross-env NODE_ENV=test npx c8 --reporter=text --reporter=lcov --reporter=html tsx --test --test-reporter=spec \"tests/unit/**/*.test.ts\"",
		"test:e2e": "playwright test --config=tests/playwright.config.ts",
		"evals": "tsx scripts/run-evals.ts",
		"sec-pii-scan": "tsx scripts/security-pii-scanner.ts",
		"scraper:auth": "tsx scripts/linkedin-auth.ts"
	},
	"c8": {
		"thresholds": {
			"lines": 70,
			"functions": 70,
			"branches": 70,
			"statements": 70
		},
		"perFile": {
			"src/start.ts": {
				"lines": 40,
				"branches": 50
			},
			"src/scraper/linkedin.ts": {
				"lines": 40
			},
			"public/utils/modal.ts": {
				"lines": 80
			},
			"src/storage/jobDataSqlite.ts": {
				"lines": 75
			}
		},
		"exclude": [
			"tests/**",
			"public/dist/**",
			"scripts/**",
			"setup.ts",
			"build.ts",
			"start.ts"
		]
	},
	"lint-staged": {
		"*.{js,ts}": [
			"npm run lint:fix",
			"npm run format:fix"
		],
		"*.{json,md,html}": [
			"npm run format:fix"
		]
	},
	"keywords": [
		"resume",
		"ats",
		"ai",
		"cv",
		"scoring",
		"generation"
	],
	"author": "Juani Cañete",
	"license": "MIT",
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.4.2",
		"formidable": "^3.5.0",
		"pdf-parse-fork": "^1.1.0",
		"playwright-extra": "^4.3.0",
		"puppeteer-extra-plugin-stealth": "^2.11.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@playwright/test": "^1.61.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/formidable": "^3.5.1",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"cross-env": "^10.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-html": "^8.1.4",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-no-only-tests": "^3.4.0",
		"eslint-plugin-playwright": "^2.11.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-yml": "^3.8.1",
		"globals": "^17.11.0",
		"html-validate": "^11.10.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^15.2.0",
		"postcss-html": "^1.8.1",
		"prettier": "^3.9.6",
		"prettier-plugin-multiline-arrays": "^4.1.11",
		"stylelint": "^16.0.0",
		"stylelint-config-standard": "^36.0.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	}
}
