#!/usr/bin/env sh
set -e

BRANCH="${GIT_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}"
echo "Running pre-push validations on $BRANCH..."
  npm run build:check
if [ "$BRANCH" = "main" ]; then
  npm run validate
else
  npm run validate -- --skip-evals
fi
  npm run typecheck
  npm run lint
  npm run test:unit
  npm run html:validate
  npm run css:validate
  npm run build
  npm run test:e2e

echo "All pre-push validations passed ✅"