#!/usr/bin/env sh
set -e

# Ensure 6gb of memory allocation for the pre-commit process
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=6144}"

BRANCH="${GIT_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}"
echo "Running pre-push validations on $BRANCH..."

# Skip evals on non-main branches and during prebuild
if [ "$BRANCH" != "main" ]; then
  export VALIDATE_SKIP_EVALS=1
fi

# Validate prompts + optional evals (gated by VALIDATE_SKIP_EVALS)
npm run preflight

# Static checks
npm run typecheck
npm run lint
npm run format
npm run html:validate
npm run css:validate

# Build (prebuild runs validate again — skip evals to avoid double run on main)
export VALIDATE_SKIP_EVALS=1
npm run build

# Unit + E2E tests
npm run test:unit
npm run test:e2e

echo "All pre-push validations passed ✅"