# resumessi Configuration
# Copy this file to .env and fill in your values.
# Then run: node setup.js

# --- API Configuration ---
# Supported providers: Google Gemini (primary) and Groq (fallback).
# Get your Gemini key at: https://aistudio.google.com/app/apikey
# Get your Groq key at:   https://console.groq.com/keys

AI_API_KEY=your_api_key_here
AI_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_API_KEY=your_fallback_api_key_here

# --- Theme Colors (override as needed) ---
PRIMARY_COLOR=#0a0a0a
SECONDARY_COLOR=#0a0a0a
ACCENT_COLOR=#2563eb
TEXT_COLOR=#171717
TEXT_LIGHT_COLOR=#404040
BG_BADGE_COLOR=#f1f5f9
SUCCESS_COLOR=#0ea5e9
