# resumessi Configuration
# Copy this file to .env and fill in your values.
# Then run: tsx setup.ts

# --- Inference Order ---
# Comma-separated list of providers to try in order.
# Supported providers: cohere, mistral, gemini, groq
# Example: AI_INFERENCE_ORDER='gemini, mistral , cohere, groq'
AI_INFERENCE_ORDER='gemini, mistral , cohere, groq'

# --- Provider API Keys ---
# Get your Cohere key at:     https://dashboard.cohere.com/api-keys
# Get your Mistral key at:    https://admin.mistral.ai/organization/api-keys
# Get your Gemini key at:     https://aistudio.google.com/api-keys
# Get your Groq key at:       https://console.groq.com/keys

COHERE_API_KEY=your_cohere_key_here
COHERE_MODEL=command-a-reasoning-08-2025

MISTRAL_API_KEY=your_mistral_key_here
MISTRAL_MODEL=codestral-2508

GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Theme Colors (override as needed) ---
PRIMARY_COLOR=#0a0a0a
SECONDARY_COLOR=#0a0a0a
ACCENT_COLOR=#2563eb
TEXT_COLOR=#171717
TEXT_LIGHT_COLOR=#404040
BG_BADGE_COLOR=#f1f5f9
SUCCESS_COLOR=#0ea5e9

# --- LinkedIn Scraper ---
# Auth mechanism: 'codegen' (manual browser login) or 'ai' (automated login)
LINKEDIN_AUTH=codegen

# Only needed for LINKEDIN_AUTH=ai
LINKEDIN_EMAIL=your_linkedin_email_here
LINKEDIN_PASSWORD=your_linkedin_password_here

# Google Authenticator OTP secret (base32). Required for automated 2FA.
LINKEDIN_OTP_SECRET=your_otp_secret_here

