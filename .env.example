# resumessi Configuration
# Copy this file to .env and fill in your values.
# Then run: tsx setup.ts

# --- Inference Order ---
# Comma-separated list of providers to try in order.
# Supported providers: cohere, mistral, gemini, groq
# Example: AI_INFERENCE_ORDER='gemini, mistral , cohere, groq'
AI_INFERENCE_ORDER='gemini, mistral , cohere, groq'

# --- Provider API Keys ---
# Get your Cohere key at:     https://dashboard.cohere.com/api-keys
# Get your Mistral key at:    https://admin.mistral.ai/organization/api-keys
# Get your Gemini key at:     https://aistudio.google.com/api-keys
# Get your Groq key at:       https://console.groq.com/keys

COHERE_API_KEY=your_cohere_key_here
COHERE_MODEL=command-a-reasoning-08-2025-08-2024

MISTRAL_API_KEY=your_mistral_key_here
MISTRAL_MODEL=codestral-2508

GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- SerpAPI (Google Search) ---
# Get your SerpAPI key at: https://serpapi.com/manage-api-key
GOOGLE_API_KEY=your_serpapi_key_here

# --- Scraper Debug ---
# Set to 'true' to write debug HTML/JSON files to data/scraper-debug/ during scraping.
# These files may contain session data — keep disabled unless debugging.
SCRAPER_DEBUG=false

# --- Scraper Job Board Hosts ---
# Comma-separated list of hostnames that should accept any URL path (not just /jobs/ patterns).
# If empty, defaults to: jobs.lever.co,jobs.ashbyhq.com,myworkdayjobs.com,teamtailor.com,greenhouse.io,bamboohr.com,torre.ai,remoterocketship.com
SCRAPER_JOB_BOARD_HOSTS=

# --- Theme Colors (override as needed) ---
PRIMARY_COLOR=#0a0a0a
SECONDARY_COLOR=#0a0a0a
ACCENT_COLOR=#2563eb
TEXT_COLOR=#171717
TEXT_LIGHT_COLOR=#404040
BG_BADGE_COLOR=#f1f5f9
SUCCESS_COLOR=#0ea5e9

# --- Collection URL Detection ---
# Set to 'false' to allow fetching collection pages (not recommended).
COLLECTION_WARNING_ENABLED=true

# --- Remote Rocketship Scraper ---
# Playwright browser path (optional, auto-detected if not set)
REMOTEROCKETSHIP_BROWSER_PATH=
# Timeout for page navigation and operations (ms)
REMOTEROCKETSHIP_TIMEOUT_MS=30000
# Rate limit between requests (ms)
REMOTEROCKETSHIP_RATE_LIMIT_MS=2000
