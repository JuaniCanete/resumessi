# Dockerfile.scraper — Lightweight CI image for resumessi job scraper
FROM mcr.microsoft.com/playwright:v1.52.0-noble

WORKDIR /app

# Copy package definition and install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy application source
COPY . .

# Set environment variable pointing to container Chrome/Chromium binary
ENV CHROME_PATH=/usr/bin/chromium

EXPOSE 3000

CMD ["npm", "start"]
